# Read API indexer (M6) base URL, without the /x207 prefix. Required.
X207_READ_API_URL=
# Circle to clear. Same as the part after "x207:" in the x402 network name.
X207_CIRCLE_ID=agents-main
# Upper bound of edges in one proposal (ADR-32 K-44).
MAX_EDGES_PER_TX=300

# Used by src/submit (SV-006).
NEAR_RPC_URL=
X207_CONTRACT_ID=
SOLVER_ACCOUNT_ID=
SOLVER_PRIVATE_KEY=
# Gas attached to submit_clearing in Tgas, 1..300. Optional.
SUBMIT_GAS_TGAS=300
